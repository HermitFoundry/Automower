@page "/"
@inject MowerService MowerService
@inject MowerDetailService MowerDetailService
@inject TrackingService TrackingService
@inject LocationService LocationService
@inject WeatherService WeatherService

<PageTitle>Automower Dashboard</PageTitle>

<div class="page-header">
    <h1>🌱 Mower Dashboard</h1>
    <button class="btn-refresh" @onclick="LoadAsync" disabled="@_loading">
        @(_loading ? "Refreshing…" : "🔄 Refresh")
    </button>
</div>

@if (_error is not null)
{
    <p class="banner banner-error">⚠️ @_error</p>
}

@if (_loading && _cards.Count == 0)
{
    <p class="muted">Loading live status…</p>
}
else if (_cards.Count == 0 && _error is null)
{
    <p class="muted">No mowers found. Run <code>list</code> from the CLI first.</p>
}

<div class="mower-grid">
    @foreach (var card in _cards)
    {
        <div class="mower-card @MowerDisplay.StatusClass(card.Activity, card.Connected)">
            <div class="mower-card-header">
                <span class="mower-icon @MowerDisplay.IconClass(card.Activity)" title="@MowerDisplay.Title(card.Activity, card.Connected)">@MowerDisplay.Icon(card.Activity, card.Connected)</span>
                <h2>@card.Name</h2>
            </div>

            <div class="mower-top-row">
                <dl class="mower-facts">
                    <dt>Activity</dt>
                    <dd>@MowerDisplay.Label(card.Activity)</dd>
                    <dt>Battery</dt>
                    <dd>@MowerDisplay.BatteryLabel(card.BatteryPercent, card.Activity, card.RemainingChargingSeconds)</dd>
                    <dt>Work area</dt>
                    <dd>@(card.WorkAreaName ?? "—")</dd>
                    <dt>Connected</dt>
                    <dd>@(card.Connected ? "✅ yes" : "❌ no")</dd>
                    <dt>Next start</dt>
                    <dd>@card.NextStartLabel</dd>
                    @if (card.Location is not null)
                    {
                        <dt>Location</dt>
                        <dd>📍 @card.Location</dd>
                    }
                    @if (card.Weather is not null)
                    {
                        <dt>Weather</dt>
                        <dd>@MowerDisplay.WeatherIcon(card.Weather) @card.Weather.TemperatureCelsius.ToString("F0")°C, @MowerDisplay.WeatherLabel(card.Weather.WeatherCode)</dd>
                    }
                    <dt>Mowed</dt>
                    <dd>@MowerDisplay.MowingCell(card.TodayMowing)</dd>
                    <dt>Charging</dt>
                    <dd>@MowerDisplay.DurationCell(card.TodayCharging)</dd>
                </dl>
                <div class="day-chart" title="Today, 06:00–18:00 (approximate)">
                    <svg viewBox="0 0 100 100">
                        <circle cx="50" cy="50" r="45" class="day-chart-bg" />
                        @foreach (var slice in card.PieSlices)
                        {
                            <path d="@slice.PathData" fill="@slice.ColorVar"><title>@slice.Title</title></path>
                        }
                    </svg>
                </div>
            </div>

            <h3>📅 Today</h3>
            @if (card.TodaySessions.Count == 0)
            {
                <p class="muted small">No activity logged today yet.</p>
            }
            else
            {
                <ul class="session-list">
                    @foreach (var s in card.TodaySessions)
                    {
                        <li>
                            <span class="@MowerDisplay.IconClass(s.Activity)" title="@MowerDisplay.Label(s.Activity)">@MowerDisplay.Icon(s.Activity, true)</span>
                            <span>@s.Start.ToString("HH:mm")–@(s.End?.ToString("HH:mm") ?? "now")</span>
                            <span class="muted">(@SessionDuration(s).FormatDuration())</span>
                            @if (s.WorkAreaName is not null)
                            {
                                <span class="muted">[@s.WorkAreaName]</span>
                            }
                        </li>
                    }
                </ul>
            }

            <h3>📊 Last 7 days</h3>
            @if (card.LastWeek.Count == 0)
            {
                <p class="muted small">No track history yet.</p>
            }
            else
            {
                <table class="week-table">
                    <thead><tr><th>Date</th><th>Mowing</th><th>Charging</th><th>Parked</th></tr></thead>
                    <tbody>
                        @foreach (var day in card.LastWeek)
                        {
                            <tr>
                                <td>@day.Date.ToString("MMM d")</td>
                                <td>@MowerDisplay.MowingCell(day.Mowing)</td>
                                <td>@MowerDisplay.DurationCell(day.Charging)</td>
                                <td>@MowerDisplay.DurationCell(day.Parked)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <a class="details-link" href="@($"/mower/{Uri.EscapeDataString(card.Name)}")">More details →</a>
        </div>
    }
</div>

@code {
    private List<MowerCard> _cards = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    // Deliberately no auto-refresh timer here - see AutomowerConsole's
    // SKILL.md on Husqvarna's "simultaneous.logins" auth rejection. This
    // process is a 4th independent consumer of the same app key/secret
    // alongside the 3 'track' processes; a background poll timer would add
    // another recurring source of auth traffic for a dashboard nobody's
    // continuously staring at. Loads once on first render, otherwise only
    // on an explicit click.
    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            var mowers = await MowerService.EnsureMowersAsync();
            var cards = new List<MowerCard>();

            foreach (var mower in mowers)
            {
                var detail = await MowerDetailService.GetMowerDetailAsync(mower.Id);
                var a = detail.Attributes;

                var sessions = TrackingService.SummarizeSessions(mower.Name, includeCalendarInfo: false);
                var today = TrackingService.SplitChargerSessions(
                    sessions.Where(s => s.Start.Date == DateTimeOffset.Now.Date)).ToList();
                var lastWeek = TrackingService.SummarizeDailyActivity(mower.Name).Take(7).ToList();

                // Same already-split session list feeds the session list,
                // the Mowed/Charging totals, and the pie chart, so none of
                // the three can ever visually disagree with each other.
                var todayTotals = TrackingService.AggregateDailyActivity(today).FirstOrDefault();
                var pieSlices = MowerDisplay.BuildDayPieSlices(today);

                // Newest breadcrumb (Positions[0]) as "where is it right
                // now" - absent for a mower with no GPS capability/fix, in
                // which case both just come back null and the card simply
                // omits those two rows (see the @if checks in the markup).
                var position = (a.Positions ?? []).FirstOrDefault();
                string? location = null;
                WeatherInfo? weather = null;
                if (position is not null)
                {
                    location = await LocationService.GetPlaceNameAsync(position.Latitude, position.Longitude);
                    weather = await WeatherService.GetCurrentWeatherAsync(position.Latitude, position.Longitude);
                }

                cards.Add(new MowerCard(
                    mower.Name,
                    a.Mower.Activity,
                    a.Metadata.Connected,
                    a.Battery.BatteryPercent,
                    a.Battery.RemainingChargingTime,
                    MowerDisplay.WorkAreaName(a),
                    MowerDisplay.NextStartLabel(a),
                    location,
                    weather,
                    today,
                    lastWeek,
                    todayTotals?.Mowing ?? [],
                    todayTotals?.Charging ?? TimeSpan.Zero,
                    pieSlices));
            }

            _cards = cards;
        }
        catch (Exception ex)
        {
            _error = $"Couldn't load live status: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private static TimeSpan SessionDuration(TrackSession s) => (s.End ?? DateTimeOffset.Now) - s.Start;

    private record MowerCard(
        string Name,
        string Activity,
        bool Connected,
        int BatteryPercent,
        long RemainingChargingSeconds,
        string? WorkAreaName,
        string NextStartLabel,
        string? Location,
        WeatherInfo? Weather,
        List<TrackSession> TodaySessions,
        List<DailyActivity> LastWeek,
        List<WorkAreaTime> TodayMowing,
        TimeSpan TodayCharging,
        List<MowerDisplay.PieSlice> PieSlices);
}
