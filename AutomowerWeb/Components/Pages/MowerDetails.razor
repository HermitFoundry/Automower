@page "/mower/{Name}"
@inject MowerService MowerService
@inject MowerDetailService MowerDetailService
@inject ScheduleService ScheduleService
@inject TrackingService TrackingService
@inject LocationService LocationService
@inject WeatherService WeatherService
@inject CoverageService CoverageService
@inject IMowerRepositoryFactory MowerRepositoryFactory

<PageTitle>@Name - Automower</PageTitle>

<a class="back-link" href="/">← Dashboard</a>

@if (_loading)
{
    <p class="muted">Loading…</p>
}
else if (_error is not null)
{
    <p class="banner banner-error">⚠️ @_error</p>
}
else if (_detail is not null && _stored is not null)
{
    var a = _detail.Attributes;

    <div class="details-header">
        <span class="mower-icon @MowerDisplay.IconClass(a.Mower.Activity)" title="@MowerDisplay.Title(a.Mower.Activity, a.Metadata.Connected)">@MowerDisplay.Icon(a.Mower.Activity, a.Metadata.Connected)</span>
        <h1>@_stored.Name</h1>
    </div>

    @if (a.Mower.ErrorCode != 0)
    {
        <p class="banner banner-error">⚠️ Error @a.Mower.ErrorCode: @ErrorCodes.Describe(a.Mower.ErrorCode)</p>
    }

    <dl class="mower-facts">
        <dt>Activity</dt>
        <dd>@MowerDisplay.Label(a.Mower.Activity)</dd>
        <dt>Battery</dt>
        <dd>@MowerDisplay.BatteryLabel(a.Battery.BatteryPercent, a.Mower.Activity, a.Battery.RemainingChargingTime)</dd>
        <dt>Work area</dt>
        <dd>@(MowerDisplay.WorkAreaName(a) ?? "—")</dd>
        <dt>Connected</dt>
        <dd>@(a.Metadata.Connected ? "✅ yes" : "❌ no")</dd>
        <dt>Next start</dt>
        <dd>@MowerDisplay.NextStartLabel(a)</dd>
        <dt>Override</dt>
        <dd>@MowerDisplay.OverrideLabel(a.Planner.Override?.Action)</dd>
        @{ var restricted = MowerDisplay.RestrictedLabel(a.Planner.RestrictedReason, a.Planner.ExternalReason); }
        @if (restricted is not null)
        {
            <dt>Restricted</dt>
            <dd>@restricted</dd>
        }
        <dt>Model</dt>
        <dd>@_stored.Model</dd>
        <dt>Serial number</dt>
        <dd>@_stored.SerialNumber</dd>
        @if (_location is not null)
        {
            <dt>Location</dt>
            <dd>📍 @_location</dd>
        }
        @if (_weather is not null)
        {
            <dt>Weather</dt>
            <dd>@MowerDisplay.WeatherIcon(_weather) @_weather.TemperatureCelsius.ToString("F0")°C, @MowerDisplay.WeatherLabel(_weather.WeatherCode)</dd>
        }
    </dl>

    <section>
        <h2>🗺️ Work areas</h2>
        @if ((a.WorkAreas ?? []).Length == 0)
        {
            <p class="muted small">No work areas configured.</p>
        }
        else
        {
            <table>
                <thead><tr><th>ID</th><th>Name</th><th>Cutting height</th><th>Pattern</th><th>Progress</th><th>Enabled</th></tr></thead>
                <tbody>
                    @foreach (var wa in a.WorkAreas!)
                    {
                        <tr>
                            <td>@wa.WorkAreaId</td>
                            <td>@wa.Name.Trim()</td>
                            <td>@CuttingHeightEstimator.Label(wa.CuttingHeight, a.System.Model)</td>
                            <td>@MowerDisplay.WorkAreaPatternLabel(wa.Type)</td>
                            <td title="@MowerDisplay.WorkAreaProgressTitle(wa)">@MowerDisplay.WorkAreaProgressCell(wa)</td>
                            <td>@(wa.Enabled ? "✅" : "❌")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="muted small">
                The cm figures are an estimate (min/max blade height isn't exposed by
                the API) - the app's own display may differ slightly.
            </p>
        }
    </section>

    <section>
        <h2>🚫 Stay-out zones</h2>
        @if (a.StayOutZones is null || a.StayOutZones.Zones.Length == 0)
        {
            <p class="muted small">No stay-out zones configured.</p>
        }
        else
        {
            <ul>
                @foreach (var z in a.StayOutZones.Zones)
                {
                    <li>@z.Name @(z.Enabled ? "" : "(disabled)")</li>
                }
            </ul>
        }
    </section>

    <section>
        <h2>📅 Schedule</h2>
        @{
            var tasks = a.Calendar?.Tasks ?? [];
            var workAreaNames = (a.WorkAreas ?? []).ToDictionary(w => w.WorkAreaId, w => w.Name.Trim());
        }
        @if (tasks.Length == 0)
        {
            <p class="muted small">No calendar tasks configured.</p>
        }
        else
        {
            <ul>
                @foreach (var t in tasks)
                {
                    <li>@FormatTask(t, workAreaNames)</li>
                }
            </ul>
            var next = ScheduleService.NextCalendarStart(tasks, DateTimeOffset.Now);
            <p class="muted small">Next calendar start: @(next?.ToString("yyyy-MM-dd HH:mm") ?? "none")</p>
        }
    </section>

    <section>
        <h2>📊 Daily rollup (last month)</h2>
        @if (_days.Count == 0)
        {
            <p class="muted small">No track history in the last month.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Date</th><th>Mowing</th><th>Charging</th><th>Parked</th></tr></thead>
                <tbody>
                    @foreach (var day in _days)
                    {
                        <tr>
                            <td>@day.Date.ToString("yyyy-MM-dd")</td>
                            <td>@MowerDisplay.MowingCell(day.Mowing)</td>
                            <td>@MowerDisplay.DurationCell(day.Charging)</td>
                            <td>@MowerDisplay.DurationCell(day.Parked)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section>
        <h2>📊 Monthly rollup</h2>
        @if (_months.Count == 0)
        {
            <p class="muted small">No track history yet.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Month</th><th>Mowing</th><th>Charging</th><th>Parked</th></tr></thead>
                <tbody>
                    @foreach (var month in _months)
                    {
                        <tr>
                            <td>@month.Month.ToString("yyyy-MM")</td>
                            <td>@MowerDisplay.MowingCell(month.Mowing)</td>
                            <td>@MowerDisplay.DurationCell(month.Charging)</td>
                            <td>@MowerDisplay.DurationCell(month.Parked)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section>
        <h2>🕒 Session history (last 7 days)</h2>
        @if (_sessions.Count == 0)
        {
            <p class="muted small">No track history in the last 7 days.</p>
        }
        else
        {
            <table>
                <thead><tr><th></th><th>Date</th><th>Activity</th><th>Time</th><th>Duration</th><th>Battery</th><th>Area</th></tr></thead>
                <tbody>
                    @foreach (var s in _sessions)
                    {
                        <tr>
                            <td class="@MowerDisplay.IconClass(s.Activity)" title="@MowerDisplay.Label(s.Activity)">@MowerDisplay.Icon(s.Activity, true)</td>
                            <td>@s.Start.ToString("yyyy-MM-dd")</td>
                            <td>@MowerDisplay.Label(s.Activity)</td>
                            <td>@s.Start.ToString("HH:mm")–@(s.End?.ToString("HH:mm") ?? "ongoing")</td>
                            <td>@SessionDuration(s).FormatDuration()</td>
                            <td>@s.BatteryStart%→@s.BatteryEnd%</td>
                            <td>@(s.WorkAreaName ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section>
        <h2>✉️ Recent messages</h2>
        @if (_messages.Count == 0)
        {
            <p class="muted small">No messages.</p>
        }
        else
        {
            <ul>
                @foreach (var m in _messages)
                {
                    <li>@DateTimeOffset.FromUnixTimeSeconds(m.Time).ToLocalTime().ToString("yyyy-MM-dd HH:mm") — @m.Severity: @ErrorCodes.Describe(m.Code)</li>
                }
            </ul>
        }
    </section>

    <section>
        <h2>⚙️ Settings &amp; capabilities</h2>
        <dl class="mower-facts">
            <dt>Cutting height (dial)</dt>
            <dd>@(a.Settings?.CuttingHeight?.ToString() ?? "—") <span class="muted small">of 9</span></dd>
            <dt>Headlight mode</dt>
            <dd>@MowerDisplay.HeadlightModeLabel(a.Settings?.Headlight?.Mode)</dd>
        </dl>
        @if (a.Capabilities is null)
        {
            <p class="muted small">No capability info reported.</p>
        }
        else
        {
            <ul class="capability-list">
                <li>@(a.Capabilities.Headlights ? "✅" : "❌") Headlights</li>
                <li>@(a.Capabilities.WorkAreas ? "✅" : "❌") Work areas</li>
                <li>@(a.Capabilities.Position ? "✅" : "❌") GPS position</li>
                <li>@(a.Capabilities.StayOutZones ? "✅" : "❌") Stay-out zones</li>
                <li>@(a.Capabilities.CanConfirmError ? "✅" : "❌") Can confirm errors via app</li>
            </ul>
        }
    </section>

    <section>
        <h2>📈 Operation (lifetime)</h2>
        @if (a.Statistics is null)
        {
            <p class="muted small">No statistics reported.</p>
        }
        else
        {
            var st = a.Statistics;
            <dl class="mower-facts">
                <dt>Total running time</dt>
                <dd>@MowerDisplay.LifetimeDuration(st.TotalRunningTime)</dd>
                <dt>Total cutting time</dt>
                <dd>@MowerDisplay.LifetimeDuration(st.TotalCuttingTime)</dd>
                <dt>Total charging time</dt>
                <dd>@MowerDisplay.LifetimeDuration(st.TotalChargingTime)</dd>
                <dt>Total searching time</dt>
                <dd>@MowerDisplay.LifetimeDuration(st.TotalSearchingTime)</dd>
                <dt>Blade usage time</dt>
                <dd>@MowerDisplay.LifetimeDuration(st.CuttingBladeUsageTime)</dd>
                <dt>Down time</dt>
                <dd>@MowerDisplay.LifetimeDuration(st.DownTime)</dd>
                <dt>Connected uptime</dt>
                <dd>@MowerDisplay.LifetimeDuration(st.UpTime)</dd>
                <dt>Total drive distance</dt>
                <dd>@MowerDisplay.Distance(st.TotalDriveDistance)</dd>
                <dt>Charging cycles</dt>
                <dd>@st.NumberOfChargingCycles</dd>
                <dt>Collisions</dt>
                <dd>@st.NumberOfCollisions</dd>
            </dl>
        }
    </section>

    <section>
        <h2>🌱 Seasons</h2>
        @if (_seasons.Count == 0)
        {
            <p class="muted small">No daily statistics recorded yet - the first snapshot is written once a full calendar day of tracking has passed.</p>
        }
        else
        {
            <p class="muted small">
                One snapshot per calendar day of the counters above - a gap of
                @TrackingService.SeasonGapDays+ days between recorded days starts a
                new season. Each season's numbers below are the growth between its
                first and last recorded day, not an absolute total.
            </p>
            @for (var i = 0; i < _seasons.Count; i++)
            {
                var season = _seasons[i];
                var start = season[0];
                var end = season[^1];
                var isOngoing = i == _seasons.Count - 1;
                <h3>
                    Season @(i + 1): @start.Date.ToString("yyyy-MM-dd") to @end.Date.ToString("yyyy-MM-dd")@(isOngoing ? " (ongoing)" : "")
                    <span class="muted small">(@season.Count day(s) recorded)</span>
                </h3>
                @if (season.Count == 1)
                {
                    <p class="muted small">Only one day recorded so far - no growth to show yet.</p>
                }
                else
                {
                    <dl class="mower-facts">
                        <dt>Running</dt>
                        <dd>+@MowerDisplay.LifetimeDuration(end.Statistics.TotalRunningTime - start.Statistics.TotalRunningTime)</dd>
                        <dt>Cutting</dt>
                        <dd>+@MowerDisplay.LifetimeDuration(end.Statistics.TotalCuttingTime - start.Statistics.TotalCuttingTime)</dd>
                        <dt>Charging</dt>
                        <dd>+@MowerDisplay.LifetimeDuration(end.Statistics.TotalChargingTime - start.Statistics.TotalChargingTime)</dd>
                        <dt>Blade usage</dt>
                        <dd>+@MowerDisplay.LifetimeDuration(end.Statistics.CuttingBladeUsageTime - start.Statistics.CuttingBladeUsageTime)</dd>
                        <dt>Charging cycles</dt>
                        <dd>+@(end.Statistics.NumberOfChargingCycles - start.Statistics.NumberOfChargingCycles)</dd>
                        <dt>Drive distance</dt>
                        <dd>+@MowerDisplay.Distance(end.Statistics.TotalDriveDistance - start.Statistics.TotalDriveDistance)</dd>
                    </dl>
                }
            }
        }
    </section>

    <section>
        <h2>📍 Coverage (experimental)</h2>
        @if (_coveragePlot is null || _coveragePlot.Dots.Count == 0)
        {
            <p class="muted small">No coverage data yet - needs at least one real mowing session logged to track-@(_stored.Name).jsonl.</p>
        }
        else
        {
            <p class="muted small">
                One dot per poll's newest GPS fix, kept only while actually
                mowing (not leaving/going home) - colored by work area. Not
                the poll's full breadcrumb history: that can still hold
                several minutes of the *previous* stay in a different area
                (e.g. parked near the charger) for a while after the mower's
                moved on, which showed up as real dots sitting outside their
                own area. Not yet a computed boundary either, just the raw
                dot density - already outlines the rough shape well enough
                to look at. The black line is the most recent trip in that
                direction (leaving the charger, or heading home) - it's
                replaced the next time the mower makes the same trip again,
                not accumulated. The red dot is the mower's current position.
            </p>
            <div class="coverage-legend">
                @foreach (var item in _coveragePlot.Legend)
                {
                    <span><i class="swatch" style="background:@item.ColorVar"></i>@item.Name <span class="muted">(@item.Count)</span></span>
                }
            </div>
            <div class="coverage-map">
                <svg viewBox="@_coveragePlot.ViewBox" xmlns="http://www.w3.org/2000/svg">
                    @foreach (var line in _coveragePlot.TransportLines)
                    {
                        <polyline points="@line.Points" class="coverage-transport-line" />
                    }
                    @foreach (var dot in _coveragePlot.Dots)
                    {
                        <circle cx="@dot.Cx" cy="@dot.Cy" r="0.15" class="coverage-dot" fill="@dot.ColorVar" />
                    }
                    @if (_coveragePlot.CurrentPosition is { } current)
                    {
                        <circle cx="@current.Cx" cy="@current.Cy" r="0.3" class="coverage-current-dot" fill="@current.ColorVar" />
                    }
                </svg>
            </div>
        }
    </section>
}

@code {
    [Parameter] public string Name { get; set; } = "";

    private bool _loading = true;
    private string? _error;
    private StoredMower? _stored;
    private MowerData? _detail;
    private List<TrackSession> _sessions = [];
    private List<DailyActivity> _days = [];
    private List<MonthlyActivity> _months = [];
    private List<MessageItem> _messages = [];
    private string? _location;
    private WeatherInfo? _weather;
    private MowerDisplay.CoveragePlot? _coveragePlot;
    private List<List<DailyStatisticsSnapshot>> _seasons = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _stored = await MowerService.ResolveExplicitMowerAsync(Name);
            if (_stored is null)
            {
                _error = $"No mower found matching '{Name}'.";
                return;
            }

            _detail = await MowerDetailService.GetMowerDetailAsync(_stored.Id);

            // Windowed to keep the page from growing unbounded over months of
            // history - session history (the finest grain) to a rolling week,
            // daily rollup to a rolling month; the monthly rollup below is the
            // one view deliberately left unwindowed, since it's already
            // coarse enough not to grow out of hand.
            var weekAgo = DateTimeOffset.Now.AddDays(-7);
            var monthAgo = DateTimeOffset.Now.AddMonths(-1);
            _sessions = TrackingService.SplitChargerSessions(TrackingService.SummarizeSessions(_stored.Name, includeCalendarInfo: false))
                .Where(s => s.Start >= weekAgo)
                .ToList();
            _days = TrackingService.SummarizeDailyActivity(_stored.Name)
                .Where(d => d.Date >= DateOnly.FromDateTime(monthAgo.Date))
                .ToList();
            _months = TrackingService.SummarizeMonthlyActivity(_stored.Name);
            _messages = (await MowerDetailService.GetMessagesAsync(_stored.Id))
                .OrderByDescending(m => m.Time)
                .Take(20)
                .ToList();

            var position = (_detail.Attributes.Positions ?? []).FirstOrDefault();
            if (position is not null)
            {
                _location = await LocationService.GetPlaceNameAsync(position.Latitude, position.Longitude);
                _weather = await WeatherService.GetCurrentWeatherAsync(position.Latitude, position.Longitude);
            }

            var workAreaNames = (_detail.Attributes.WorkAreas ?? [])
                .ToDictionary(w => w.WorkAreaId, w => w.Name.Trim());
            var coverage = CoverageService.GetCoverageByWorkArea(_stored.Name);
            var transportPaths = CoverageService.GetLatestTransportPaths(_stored.Name);
            var currentPosition = position is null ? (GpsPoint?)null : new GpsPoint(position.Latitude, position.Longitude);
            _coveragePlot = MowerDisplay.BuildCoveragePlot(coverage, workAreaNames, transportPaths, currentPosition);

            var dailyStatistics = MowerRepositoryFactory.ForMower(_stored.Name).GetDailyStatisticsHistory()
                .OrderBy(d => d.Date)
                .ToList();
            _seasons = TrackingService.GroupIntoSeasons(dailyStatistics);
        }
        catch (Exception ex)
        {
            _error = $"Couldn't load {Name}: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private static TimeSpan SessionDuration(TrackSession s) => (s.End ?? DateTimeOffset.Now) - s.Start;

    private static string FormatTask(CalendarTask t, Dictionary<long, string> workAreaNames)
    {
        var days = new[]
        {
            (t.Monday, "Mon"), (t.Tuesday, "Tue"), (t.Wednesday, "Wed"), (t.Thursday, "Thu"),
            (t.Friday, "Fri"), (t.Saturday, "Sat"), (t.Sunday, "Sun"),
        };
        var dayLabel = string.Join(",", days.Where(d => d.Item1).Select(d => d.Item2));
        var start = TimeSpan.FromMinutes(t.Start);
        var end = TimeSpan.FromMinutes(t.Start + t.Duration);
        var area = t.WorkAreaId is { } id && workAreaNames.TryGetValue(id, out var name) ? $" [{name}]" : "";
        return $"{dayLabel}  {start:hh\\:mm}-{end:hh\\:mm}{area}";
    }
}
