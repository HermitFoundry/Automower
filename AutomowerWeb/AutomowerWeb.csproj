<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Avoids a hard dependency on libicu, which a plain 'dotnet-install.sh'
         tarball install never pulls in (unlike an apt-based install, which
         gets it automatically as a package dependency) - hit for real
         provisioning a fresh container: just running "dotnet" to check its
         version crashed outright with "Couldn't find a valid ICU package"
         otherwise. Safe here specifically because this app already formats
         everything via CultureInfo.InvariantCulture explicitly throughout -
         it was never relying on real locale-aware behavior to begin with. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- MinVer computes the version from the nearest 'v*' git tag reachable
         from HEAD plus commit height/sha - see the 'v0.9.0' tag at the repo
         root. No tag reachable (e.g. a shallow clone) falls back to 0.0.0-alpha.0. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <Copyright>Terje Sandstrom</Copyright>
    <!-- Baked in at build time (UTC), read back via AssemblyMetadataAttribute
         in AppInfo.cs - the footer's "Built <date>" is literally when this
         binary was compiled, not a runtime-computed "today". -->
    <BuildDateUtc>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd"))</BuildDateUtc>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutomowerConsole.Core\AutomowerConsole.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="7.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildDate" Value="$(BuildDateUtc)" />
  </ItemGroup>

  <ItemGroup>
    <!-- CuttingHeightEstimator reads this from AppContext.BaseDirectory at
         runtime - copy it next to the built AutomowerWeb.dll/.exe so it's
         actually there regardless of how the app is launched (dotnet run,
         the built .dll directly via startweb.sh, ...). PreserveNewest so a
         hand-edit directly in the output dir (no rebuild) survives an
         incremental build that doesn't touch this file. -->
    <Content Update="cutting-height-ranges.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
